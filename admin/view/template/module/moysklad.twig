{{ header }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
          {% if not loop.last %}
            <li>/</li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ heading_title }}</h3>
      </div>
      <div class="panel-body">
        <form method="post" enctype="multipart/form-data" id="form">
          <fieldset>
            <legend>Основные настройки</legend>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="module-moysklad-status">Статус</label>
              <div class="col-sm-10">
                <select name="module_moysklad_status" id="module-moysklad-status" class="form-control">
                  <option value="0" {% if module_moysklad_status == 0 %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                  <option value="1" {% if module_moysklad_status == 1 %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="module-moysklad-api-key">{{ entry_api_key }}</label>
              <div class="col-sm-10">
                <input type="password" name="module_moysklad_api_key" id="module-moysklad-api-key" value="{{ module_moysklad_api_key }}" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="module-moysklad-sync-frequency">{{ entry_sync_frequency }}</label>
              <div class="col-sm-10">
                <input type="number" name="module_moysklad_sync_frequency" id="module-moysklad-sync-frequency" value="{{ module_moysklad_sync_frequency }}" min="5" class="form-control" />
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="module-moysklad-price-type">{{ entry_price_type }}</label>
              <div class="col-sm-10">
                <select name="module_moysklad_price_type" id="module-moysklad-price-type" class="form-control">
                  <option value="selling" {% if module_moysklad_price_type == 'selling' %}selected="selected"{% endif %}>Розница</option>
                  <option value="purchase" {% if module_moysklad_price_type == 'purchase' %}selected="selected"{% endif %}>Закупка</option>
                  <option value="wholesale" {% if module_moysklad_price_type == 'wholesale' %}selected="selected"{% endif %}>Опт</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="module-moysklad-sync-images">{{ entry_sync_images }}</label>
              <div class="col-sm-10">
                <select name="module_moysklad_sync_images" id="module-moysklad-sync-images" class="form-control">
                  <option value="0" {% if module_moysklad_sync_images == 0 %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                  <option value="1" {% if module_moysklad_sync_images == 1 %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label" for="module-moysklad-sync-attributes">{{ entry_sync_attributes }}</label>
              <div class="col-sm-10">
                <select name="module_moysklad_sync_attributes" id="module-moysklad-sync-attributes" class="form-control">
                  <option value="0" {% if module_moysklad_sync_attributes == 0 %}selected="selected"{% endif %}>{{ text_disabled }}</option>
                  <option value="1" {% if module_moysklad_sync_attributes == 1 %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-2 control-label">Последняя синхронизация</label>
              <div class="col-sm-10">
                <p class="form-control-static">{{ module_moysklad_last_sync|default('Никогда') }}</p>
              </div>
            </div>
          </fieldset>
          <div class="form-group">
            <label class="col-sm-2 control-label"></label>
            <div class="col-sm-10">
              <button type="submit" class="btn btn-primary">{{ button_save }}</button>
              <a href="javascript:syncNow();" class="btn btn-success">{{ button_sync_now }}</a>
              <a href="javascript:testConnection();" class="btn btn-info">{{ button_test_connection }}</a>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ column_left }}
{{ footer }}
<script>
function syncNow() {
  if (confirm('Начать синхронизацию?')) {
    $.ajax({
      url: 'index.php?route=module/moysklad/sync',
      type: 'post',
      dataType: 'json',
      success: function(json) {
        if (json.status) {
          alert(json.message);
          location.reload();
        } else {
          alert('Ошибка: ' + json.message);
        }
      }
    });
  }
}

function testConnection() {
  $.ajax({
    url: 'index.php?route=module/moysklad/testConnection',
    type: 'post',
    dataType: 'json',
    success: function(json) {
      if (json.status) {
        alert(json.message);
      } else {
        alert('Ошибка: ' + json.message);
      }
    }
  });
}
</script>
